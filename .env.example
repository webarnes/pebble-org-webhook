# HMAC secret entered in Index 01 webhook settings (Sign requests).
INDEX_WEBHOOK_SECRET=

# Require X-Index-Signature. Leave true in production.
INDEX_REQUIRE_SIGNATURE=true

# Optional extra token. If set, require Authorization or X-Widget-Token to match.
INDEX_AUTH_TOKEN=

# Syncthing-synced Org directory on the home server.
ORG_DIRECTORY=/home/webarnes/Documents/Org
TODO_FILENAME=todo.org
# Defaults to $ORG_DIRECTORY/templates/roam.dailies.default.txt
# DAILY_TEMPLATE_PATH=

ORG_TIMEZONE=America/Toronto
DELIVERIES_DB=/var/lib/index-org-webhook/deliveries.db

# Bind localhost; Tailscale Serve publishes HTTPS on the tailnet.
BIND_HOST=127.0.0.1
BIND_PORT=8787
TIMESTAMP_LEEWAY_SECONDS=300
